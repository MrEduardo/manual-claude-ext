# Copie para .env e preencha só o que quiser mudar. O .env está no .gitignore.
# Valores vazios = comportamento padrão. As configurações do VS Code têm prioridade sobre estas variáveis.
# O .env é lido só no modo de desenvolvimento (F5). Na extensão instalada, use as
# configurações do VS Code ou defina as variáveis no ambiente do sistema.

# Onde gravar o manual (padrão: ~/.claude/manual-comandos.md)
MANUAL_CLAUDE_CAMINHO_MANUAL=

# Caminho do executável do Claude Code (padrão: detectar automaticamente)
MANUAL_CLAUDE_CAMINHO_CLAUDE=
